<?xml version="1.0" ?>
<!--
  apartment.world — Gazebo Harmonic (SDF 1.8)
  Planimetria:
  ┌─────────────────────────────────────────────┐
  │          CORRIDOIO (5x1.5m)                 │
  │  ┌──────────┐   ┌──────────┐  ┌──────────┐ │
  │  │  CUCINA  │   │SALOTTO   │  │BAGNO     │ │
  │  │ (4x3m)  │   │ (5x4m)  │  │(2x2m)   │ │
  │  └──────────┘   └──────────┘  └──────────┘ │
  │  ┌──────────────────────────────────────┐   │
  │  │        CAMERA DA LETTO (6x4m)        │   │
  │  └──────────────────────────────────────┘   │
  └─────────────────────────────────────────────┘
  Origine (0,0) = centro del corridoio
  Unità: metri. Altezza muri: 2.5m. Spessore: 0.15m
  Robot radius: 0.125m → corridoi min 0.6m liberi
-->
<sdf version="1.8">
  <world name="apartment">

    <!-- ═══════════════════════════════════════ -->
    <!--  PLUGIN OBBLIGATORI GAZEBO HARMONIC     -->
    <!-- ═══════════════════════════════════════ -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ═══════════════════════════════════════ -->
    <!--  ILLUMINAZIONE                          -->
    <!-- ═══════════════════════════════════════ -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- Luce ambiente soffusa -->
    <light name="ambient_fill" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.4 0.4 0.5 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>0.4 -0.2 -0.9</direction>
    </light>

    <!-- ═══════════════════════════════════════ -->
    <!--  PAVIMENTO                              -->
    <!-- ═══════════════════════════════════════ -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.55 0.5 1</ambient>
            <diffuse>0.6 0.55 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════ -->
    <!--  MACRO helper: un muro è un box statico -->
    <!--  pose: cx cy cz 0 0 yaw               -->
    <!--  size: lunghezza spessore altezza       -->
    <!-- ═══════════════════════════════════════ -->

    <!-- ─────────────────────────────────────── -->
    <!--  MURI PERIMETRALI ESTERNI               -->
    <!--  Appartamento: 13m x 10m               -->
    <!--  Angolo SW: (-6.5, -5.0)               -->
    <!--  Angolo NE: ( 6.5,  5.0)               -->
    <!-- ─────────────────────────────────────── -->

    <!-- Muro Sud (fondo) -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5.075 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>13.15 0.15 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>13.15 0.15 2.5</size></box></geometry>
          <material><ambient>0.85 0.82 0.78 1</ambient><diffuse>0.85 0.82 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Muro Nord (ingresso/corridoio) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5.075 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>13.15 0.15 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>13.15 0.15 2.5</size></box></geometry>
          <material><ambient>0.85 0.82 0.78 1</ambient><diffuse>0.85 0.82 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Muro Ovest -->
    <model name="wall_west">
      <static>true</static>
      <pose>-6.575 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 10.15 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 10.15 2.5</size></box></geometry>
          <material><ambient>0.85 0.82 0.78 1</ambient><diffuse>0.85 0.82 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Muro Est -->
    <model name="wall_east">
      <static>true</static>
      <pose>6.575 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 10.15 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 10.15 2.5</size></box></geometry>
          <material><ambient>0.85 0.82 0.78 1</ambient><diffuse>0.85 0.82 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ─────────────────────────────────────── -->
    <!--  MURI INTERNI                           -->
    <!--                                         -->
    <!--  Layout (Y positivo = Nord):            -->
    <!--  Y=3.5   corridoio nord                 -->
    <!--  Y=2.0   separatore corridoio/stanze N  -->
    <!--  Y=-1.5  separatore stanze N/camera     -->
    <!--  Y=-5.0  muro sud                       -->
    <!-- ─────────────────────────────────────── -->

    <!-- Muro corridoio: separa corridoio (nord) dalle stanze -->
    <!-- Corre da X=-6.5 a X=6.5 a Y=2.0                    -->
    <!-- Ha 3 aperture: cucina (X≈-4), salotto (X≈0), bagno (X≈4.5) -->

    <!-- Segmento Ovest corridoio (dal muro ovest all'apertura cucina) -->
    <model name="wall_corridor_W">
      <static>true</static>
      <pose>-5.45 2.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.2 0.15 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.2 0.15 2.5</size></box></geometry>
          <material><ambient>0.82 0.78 0.74 1</ambient><diffuse>0.82 0.78 0.74 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Segmento tra apertura cucina e apertura salotto -->
    <model name="wall_corridor_M1">
      <static>true</static>
      <pose>-2.35 2.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.5 0.15 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.5 0.15 2.5</size></box></geometry>
          <material><ambient>0.82 0.78 0.74 1</ambient><diffuse>0.82 0.78 0.74 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Segmento tra apertura salotto e apertura bagno -->
    <model name="wall_corridor_M2">
      <static>true</static>
      <pose>2.35 2.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.5 0.15 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.5 0.15 2.5</size></box></geometry>
          <material><ambient>0.82 0.78 0.74 1</ambient><diffuse>0.82 0.78 0.74 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Segmento Est corridoio (dopo apertura bagno al muro est) -->
    <model name="wall_corridor_E">
      <static>true</static>
      <pose>5.45 2.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.2 0.15 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.2 0.15 2.5</size></box></geometry>
          <material><ambient>0.82 0.78 0.74 1</ambient><diffuse>0.82 0.78 0.74 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Muro divisore cucina/salotto (verticale, da Y=2.0 a Y=-1.5) -->
    <!-- X=-2.5, lunghezza 3.5m -->
    <model name="wall_kitchen_living">
      <static>true</static>
      <pose>-2.5 0.25 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 3.5 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 3.5 2.5</size></box></geometry>
          <material><ambient>0.82 0.78 0.74 1</ambient><diffuse>0.82 0.78 0.74 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Muro divisore salotto/bagno (verticale, da Y=2.0 a Y=-1.5) -->
    <!-- X=3.5, con apertura interna al salotto -->
    <!-- Segmento nord (da Y=2.0 a Y=0.5) -->
    <model name="wall_living_bath_N">
      <static>true</static>
      <pose>3.5 1.325 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 1.3 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 1.3 2.5</size></box></geometry>
          <material><ambient>0.82 0.78 0.74 1</ambient><diffuse>0.82 0.78 0.74 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Segmento sud (da Y=-0.3 a Y=-1.5) -->
    <model name="wall_living_bath_S">
      <static>true</static>
      <pose>3.5 -0.975 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 1.05 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 1.05 2.5</size></box></geometry>
          <material><ambient>0.82 0.78 0.74 1</ambient><diffuse>0.82 0.78 0.74 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Muro separatore stanze nord / camera da letto -->
    <!-- Y=-1.5, da X=-6.5 a X=6.5, con apertura camera (X≈0.5) -->
    <!-- Segmento Ovest -->
    <model name="wall_bedroom_N_W">
      <static>true</static>
      <pose>-3.75 -1.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>5.5 0.15 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>5.5 0.15 2.5</size></box></geometry>
          <material><ambient>0.82 0.78 0.74 1</ambient><diffuse>0.82 0.78 0.74 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Segmento Est (dopo apertura) -->
    <model name="wall_bedroom_N_E">
      <static>true</static>
      <pose>4.25 -1.5 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.5 0.15 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>4.5 0.15 2.5</size></box></geometry>
          <material><ambient>0.82 0.78 0.74 1</ambient><diffuse>0.82 0.78 0.74 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Muro nord bagno (chiude il bagno in alto, Y=2.0 già coperto dal muro corridoio) -->
    <!-- Muro est bagno: già coperto dal muro perimetrale Est -->
    <!-- Muro sud bagno (Y=-1.5 già coperto) -->

    <!-- ─────────────────────────────────────── -->
    <!--  OSTACOLI / ARREDO STILIZZATO           -->
    <!-- ─────────────────────────────────────── -->

    <!-- CUCINA: isola cucina (box 1.2x0.6x0.9) centrata in X=-4.5, Y=0.3 -->
    <model name="kitchen_island">
      <static>true</static>
      <pose>-4.5 0.3 0.45 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 0.6 0.9</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.2 0.6 0.9</size></box></geometry>
          <material><ambient>0.4 0.35 0.3 1</ambient><diffuse>0.4 0.35 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Tavolo cucina piccolo (cilindro con box) -->
    <model name="kitchen_table">
      <static>true</static>
      <pose>-5.2 -0.8 0.38 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.8 0.8 0.75</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.8 0.8 0.75</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- SALOTTO: divano (box 2.0x0.8x0.45) -->
    <model name="sofa">
      <static>true</static>
      <pose>0.5 -0.8 0.225 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.0 0.8 0.45</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.0 0.8 0.45</size></box></geometry>
          <material><ambient>0.3 0.4 0.6 1</ambient><diffuse>0.3 0.4 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Tavolino da caffè (box 0.9x0.5x0.4) davanti al divano -->
    <model name="coffee_table">
      <static>true</static>
      <pose>0.55 0.2 0.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.8 0.5 0.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.8 0.5 0.4</size></box></geometry>
          <material><ambient>0.5 0.38 0.25 1</ambient><diffuse>0.5 0.38 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Mobile TV (appoggiato alla parete salotto/corridoio) -->
    <model name="tv_stand">
      <static>true</static>
      <pose>0.5 1.8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.4 0.4 0.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.4 0.4 0.5</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Libreria (appoggiata alla parete ovest del salotto) -->
    <model name="bookshelf">
      <static>true</static>
      <pose>-2.3 0.5 0.9 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 1.2 1.8</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.3 1.2 1.8</size></box></geometry>
          <material><ambient>0.45 0.32 0.2 1</ambient><diffuse>0.45 0.32 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- BAGNO: sanitari stilizzati -->
    <!-- WC (box piccolo angolo NE bagno) -->
    <model name="toilet">
      <static>true</static>
      <pose>5.8 1.5 0.225 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 0.6 0.45</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.4 0.6 0.45</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Vasca/doccia (angolo SE bagno) -->
    <model name="bathtub">
      <static>true</static>
      <pose>5.6 0.2 0.3 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.7 1.2 0.6</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.7 1.2 0.6</size></box></geometry>
          <material><ambient>0.88 0.93 0.95 1</ambient><diffuse>0.88 0.93 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- CAMERA DA LETTO: letto matrimoniale (box 1.8x2.0x0.5) -->
    <model name="bed">
      <static>true</static>
      <pose>-2.5 -3.2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.8 2.0 0.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.8 2.0 0.5</size></box></geometry>
          <material><ambient>0.7 0.6 0.55 1</ambient><diffuse>0.7 0.6 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Testata letto -->
    <model name="bed_headboard">
      <static>true</static>
      <pose>-2.5 -2.15 0.65 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.9 0.1 0.8</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.9 0.1 0.8</size></box></geometry>
          <material><ambient>0.35 0.25 0.18 1</ambient><diffuse>0.35 0.25 0.18 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Comodino sinistro -->
    <model name="nightstand_L">
      <static>true</static>
      <pose>-3.6 -3.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.5 0.6</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.5 0.5 0.6</size></box></geometry>
          <material><ambient>0.4 0.3 0.2 1</ambient><diffuse>0.4 0.3 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Comodino destro -->
    <model name="nightstand_R">
      <static>true</static>
      <pose>-1.4 -3.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.5 0.6</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.5 0.5 0.6</size></box></geometry>
          <material><ambient>0.4 0.3 0.2 1</ambient><diffuse>0.4 0.3 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Armadio (parete sud camera) -->
    <model name="wardrobe">
      <static>true</static>
      <pose>2.5 -4.6 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.4 0.6 2.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.4 0.6 2.0</size></box></geometry>
          <material><ambient>0.55 0.48 0.38 1</ambient><diffuse>0.55 0.48 0.38 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Scrivania (angolo NE camera) -->
    <model name="desk">
      <static>true</static>
      <pose>5.5 -2.0 0.375 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.6 1.4 0.75</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.6 1.4 0.75</size></box></geometry>
          <material><ambient>0.45 0.4 0.35 1</ambient><diffuse>0.45 0.4 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Sedia scrivania -->
    <model name="desk_chair">
      <static>true</static>
      <pose>4.7 -2.0 0.225 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.5 0.45</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.5 0.5 0.45</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ─────────────────────────────────────── -->
    <!--  OSTACOLI MOBILI / SPARSI               -->
    <!--  (oggetti che il robot deve evitare)    -->
    <!-- ─────────────────────────────────────── -->

    <!-- Vaso da fiori nel corridoio -->
    <model name="plant_pot_corridor">
      <static>true</static>
      <pose>-4.0 3.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><cylinder><radius>0.15</radius><length>0.6</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.15</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.2 0.5 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Scatole impilate corridoio (ostacolo stretto) -->
    <model name="boxes_stack">
      <static>true</static>
      <pose>2.5 3.8 0.3 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 0.4 0.6</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.4 0.4 0.6</size></box></geometry>
          <material><ambient>0.7 0.6 0.2 1</ambient><diffuse>0.7 0.6 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Tappeto (solo visivo, nessuna collisione) -->
    <model name="rug_living">
      <static>true</static>
      <pose>0.5 0.0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="vis">
