over "lidarino"
{
    over "Physics"
    {
        def MjcActuator "L_wheel_Revolute_actuator"
        {
            uniform double mjc:forceRange:max = 10
            uniform double mjc:forceRange:min = -10
            custom rel mjc:target
            prepend rel mjc:target = </lidarino/Physics/L_wheel_Revolute>
        }

        def MjcActuator "R_wheel_Revolute_actuator"
        {
            uniform double mjc:forceRange:max = 10
            uniform double mjc:forceRange:min = -10
            custom rel mjc:target
            prepend rel mjc:target = </lidarino/Physics/R_wheel_Revolute>
        }

        over "root_joint"
        {
        }

        over "L_wheel_Revolute" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
        }

        over "R_wheel_Revolute" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
