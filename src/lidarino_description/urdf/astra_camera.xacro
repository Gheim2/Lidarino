<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="astra_camera" params="parent xyz rpy">

        <link name="astra_link">
            <visual>
                <geometry>
                    <box size="0.04 0.165 0.03" />
                </geometry>
                <material name="dark_grey">
                </material>
            </visual>
            <collision>
                <geometry>
                    <box size="0.04 0.165 0.03" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.3" />
                <inertia ixx="0.000703" iyy="0.000063" izz="0.000721" ixy="0" iyz="0" ixz="0" />
            </inertial>
        </link>

        <joint name="astra_joint" type="fixed">
            <parent link="${parent}" />
            <child link="astra_link" />
            <origin xyz="${xyz}" rpy="${rpy}" />
        </joint>

        <link name="astra_optical_frame" />
        <joint name="astra_optical_joint" type="fixed">
            <parent link="astra_link" />
            <child link="astra_optical_frame" />
            <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679" />
        </joint>

        <gazebo reference="astra_link">
            <sensor type="rgbd_camera" name="astra_pro">
                <topic>/astra/camera</topic>
                <always_on>true</always_on>
                <update_rate>30.0</update_rate>
                <camera>
                    <horizontal_fov>1.047</horizontal_fov> 
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>8.0</far>
                    </clip>
                </camera>
                <gz_frame_id>astra_optical_frame</gz_frame_id>
            </sensor>
        </gazebo>

    </xacro:macro>
</robot>