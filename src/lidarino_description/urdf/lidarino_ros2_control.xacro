<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="use_sim" default="true" />

    <xacro:macro name="lidarino_ros2_control" params="use_lidar_control use_sim">
        <ros2_control name="LidarinoSystem" type="system">
            <xacro:if value="${use_sim}">
                <hardware>
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </hardware>
                <xacro:if value="${use_lidar_control}">
                    <joint name="lidar_Revolute">
                        <command_interface name="velocity">
                            <param name="min">-100</param>
                            <param name="max">100</param>
                        </command_interface>
                        <state_interface name="position"/>
                        <state_interface name="velocity"/>
                    </joint>
                </xacro:if>
            </xacro:if>
            <xacro:unless value="${use_sim}">
                <hardware>
                    <plugin>lidarino_hardware/LidarinoSystemHardware</plugin>
                    <param name="serial_port">/dev/lidarino</param>
                    <!-- Associazione per nome: l'ordine dei joint sotto non conta -->
                    <param name="left_wheel_joint">L_wheel_Revolute</param>
                    <param name="right_wheel_joint">R_wheel_Revolute</param>
                </hardware>
            </xacro:unless>

            <joint name="R_wheel_Revolute">
                <command_interface name="velocity">
                    <param name="min">-10</param>
                    <param name="max">10</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
        
            <joint name="L_wheel_Revolute">
                <command_interface name="velocity">
                    <param name="min">-10</param>
                    <param name="max">10</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>

            <sensor name="battery_sensor">
                <state_interface name="voltage"/>
            </sensor>

            <sensor name="imu_sensor">
                <state_interface name="orientation.x"/>
                <state_interface name="orientation.y"/>
                <state_interface name="orientation.z"/>
                <state_interface name="orientation.w"/>
                <state_interface name="linear_acceleration.x"/>
                <state_interface name="linear_acceleration.y"/>
                <state_interface name="linear_acceleration.z"/>
                <state_interface name="angular_velocity.x"/>
                <state_interface name="angular_velocity.y"/>
                <state_interface name="angular_velocity.z"/>
            </sensor>
        </ros2_control>
    </xacro:macro>

</robot>
