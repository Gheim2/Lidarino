<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!--
        IMU per sensor fusion (es. robot_localization ekf_node).
        Topic pubblicato: /imu (sensor_msgs/msg/Imu)
        Frame: imu_link (X=avanti, Y=sinistra, Z=su)
    -->
    <xacro:macro name="imu_sensor" params="parent xyz rpy">

        <link name="imu_link">
            <inertial>
                <!-- IMU reale tipica: pochi grammi, trascurabile dal punto di vista
                     inerziale ma serve comunque un inertial valido per KDL/ros2_control -->
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="0.01" />
                <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0.0" iyz="0.0" ixz="0.0" />
            </inertial>
            <visual name="imu_visual">
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="0.02 0.02 0.005" />
                </geometry>
                <material name="dark_grey" />
            </visual>
            <collision name="imu_collision">
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="0.02 0.02 0.005" />
                </geometry>
            </collision>
        </link>

        <joint name="imu_joint" type="fixed">
            <parent link="${parent}" />
            <child link="imu_link" />
            <origin xyz="${xyz}" rpy="${rpy}" />
        </joint>

        <gazebo reference="imu_link">
            <sensor type="imu" name="imu_sensor">
                <topic>/imu</topic>
                <always_on>true</always_on>
                <update_rate>100.0</update_rate>
                <gz_frame_id>imu_link</gz_frame_id>
                <imu>
                    <!--
                        Rumore realistico: senza questo i valori sarebbero perfetti e
                        l'EKF di robot_localization non avrebbe nulla da "fondere" in modo
                        sensato — i pesi del filtro si baserebbero su covarianze finte.
                        Valori tipici per un IMU MEMS economico (es. MPU6050 / BNO055-class).
                    -->
                    <angular_velocity>
                        <x>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>0.0003</stddev>
                                <bias_mean>0.0000075</bias_mean>
                                <bias_stddev>0.0000008</bias_stddev>
                            </noise>
                        </x>
                        <y>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>0.0003</stddev>
                                <bias_mean>0.0000075</bias_mean>
                                <bias_stddev>0.0000008</bias_stddev>
                            </noise>
                        </y>
                        <z>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>0.0003</stddev>
                                <bias_mean>0.0000075</bias_mean>
                                <bias_stddev>0.0000008</bias_stddev>
                            </noise>
                        </z>
                    </angular_velocity>
                    <linear_acceleration>
                        <x>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>0.017</stddev>
                                <bias_mean>0.1</bias_mean>
                                <bias_stddev>0.001</bias_stddev>
                            </noise>
                        </x>
                        <y>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>0.017</stddev>
                                <bias_mean>0.1</bias_mean>
                                <bias_stddev>0.001</bias_stddev>
                            </noise>
                        </y>
                        <z>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>0.017</stddev>
                                <bias_mean>0.1</bias_mean>
                                <bias_stddev>0.001</bias_stddev>
                            </noise>
                        </z>
                    </linear_acceleration>
                </imu>
            </sensor>
        </gazebo>

    </xacro:macro>
</robot>
