<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Lidarino">
    
    <link name="base_link">
        <inertial>
            <origin xyz="-0.0062724127968771535 1.3799035175597654e-08 0.013070827636125267" rpy="0.0 0.0 0.0" />
            <mass value="0.4239314641509377" />
            <inertia ixx="0.0010482842137546186" iyy="0.0024338106744802982" izz="0.003184067568059869" ixy="-9.417101996162051e-05" iyz="-2.234993490616969e-06" ixz="0.0001129151524043299" />
