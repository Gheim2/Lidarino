    </link>

    <joint name="L_wheel_Revolute" type="continuous">
        <origin xyz="-0.06 0.06 0.015" rpy="1.5707963267948966 -0.0 0.0" />
        <parent link="base_link" />
        <child link="wheel_L" />
        <axis xyz="0.0 0.0 -1.0" />
        <limit effort="10.0" velocity="20.0" />
    </joint>

    <joint name="R_wheel_Revolute" type="continuous">
        <origin xyz="-0.06 -0.06 0.015" rpy="-1.5707963267948966 -0.0 0.0" />
        <parent link="base_link" />
        <child link="wheel_R" />
        <axis xyz="0.0 0.0 1.0" />
        <limit effort="10.0" velocity="20.0" />
    </joint>

    <joint name="caster_fixed" type="fixed">
        <origin xyz="0.052 0.0 -0.013" rpy="0.0 0.0 0.0" />
        <parent link="base_link" />
        <child link="caster" />
    </joint>
</robot>