        <visual name="base_link_visual">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <geometry>
                <mesh filename="${mesh_url}base_link_s2.stl" scale="0.001 0.001 0.001" />
            </geometry>
            <material name="steel_blue" />
        </visual>
